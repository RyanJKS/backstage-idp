# Copy this file to .env.yarn and replace the placeholder credentials.
# Use unquoted, literal KEY=value entries. Never commit .env.yarn.

# PostgreSQL: Compose overrides the host and port for its own database.
# For production, use a database address reachable from the app container.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=backstage
POSTGRES_PASSWORD=replace-with-a-strong-password

# GitHub OAuth app credentials for sign-in.
# Local callback: http://localhost:7007/api/auth/github/handler/frame
AUTH_GITHUB_CLIENT_ID=replace-with-your-client-id
AUTH_GITHUB_CLIENT_SECRET=replace-with-your-client-secret

# GitHub personal access token for catalog imports and scaffolding.
GITHUB_TOKEN=replace-with-your-token

# Production image only: use your public HTTPS portal URL when deploying.
APP_BASE_URL=http://localhost:7007
